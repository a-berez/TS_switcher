{
  "manifest_version": 3,
  "name": "TS_switcher",
  "version": "1.0.0.3",
  "description": "Переключение между Турнирным сайтом, зеркалами и сайтами рейтинга",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "declarativeNetRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "https://rating.chgk.info/*",
    "https://rating.pecheny.me/*",
    "https://rating.pecheny.kz/*",
    "https://rating.pecheny.ru/*",
    "https://rating.chgk.gg/*",
    "https://rating.chgk.fun/*",
    "https://chgk.quest/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://rating.chgk.info/*",
        "https://rating.pecheny.me/*",
        "https://rating.pecheny.kz/*",
        "https://rating.pecheny.ru/*",
        "https://rating.chgk.gg/*",
        "https://rating.chgk.fun/*",
        "https://chgk.quest/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
