{
  "manifest_version": 2,
  "name": "TS_switcher",
  "version": "1.0.0.5",
  "description": "Переключение между Турнирным сайтом, зеркалами и сайтами рейтинга",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "https://rating.chgk.info/*",
    "https://rating.pecheny.me/*",
    "https://rating.pecheny.kz/*",
    "https://rating.pecheny.ru/*",
    "https://rating.chgk.gg/*",
    "https://rating.chgk.fun/*",
    "https://chgk.quest/*",
    "https://elo-chgk.uk/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["sites.js", "settings.js", "background-firefox.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://rating.chgk.info/*",
        "https://rating.pecheny.me/*",
        "https://rating.pecheny.kz/*",
        "https://rating.pecheny.ru/*",
        "https://rating.chgk.gg/*",
        "https://rating.chgk.fun/*",
        "https://chgk.quest/*",
        "https://elo-chgk.uk/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ts-switcher@chgk.info",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
